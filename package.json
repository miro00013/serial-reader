{
  "name": "serial-reader",
  "version": "1.0.0",
  "description": "応募抽選用シリアルナンバー読み取り",
  "main": "main.js",
  "author": "torikomi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.serial.reader",
    "productName": "SerialReader",
    "artifactName": "SerialReader.exe",
    "files": ["main.js", "index.html", "vendor/**"],
    "win": {
      "target": "portable"
    }
  }
}
